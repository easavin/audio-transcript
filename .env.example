# --- Required ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather

# Comma-separated Telegram user IDs for ADMINS (you).
# Admins are auto-allowed and can /grant /revoke /users at runtime.
# Regular allowed users are stored in the DB — no redeploy needed to add them.
# Leave empty initially: run the bot, send /start, it will reply with your ID.
# Then add the ID here and restart — you become admin. From then on use /grant.
ADMIN_USER_IDS=

# Neon Postgres. Get it from https://console.neon.tech → connection string.
# Use the pooled connection for serverless; non-pooled is fine here.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Providers ---
STT_PROVIDER=groq
GROQ_API_KEY=gsk_...

LLM_PROVIDER=gemini
GEMINI_API_KEY=...

# --- Optional (for local fallback later) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# --- WhatsApp Cloud API (Phase 2) ---
# Leave all of these empty to run Telegram-only.
# A verify token YOU make up; paste the same value into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret (App → Settings → Basic). Validates inbound event signatures.
WHATSAPP_APP_SECRET=
# Permanent System User access token from the Meta Business settings.
WHATSAPP_ACCESS_TOKEN=
# Phone number ID (WhatsApp → API Setup) — NOT the human phone number.
WHATSAPP_PHONE_NUMBER_ID=
# Admin WhatsApp numbers in wa_id form — digits only, no '+'. Comma-separated.
WHATSAPP_ADMIN_IDS=
# Graph API version. Bump as Meta releases new ones.
GRAPH_API_VERSION=v21.0

# --- Runtime ---
# Public base URL of the deployment (required on Railway). Used for BOTH the
# Telegram webhook (/telegram/<secret>) and the WhatsApp webhook (/whatsapp).
# Format: https://your-app.up.railway.app
# Leave empty locally → Telegram runs in polling mode.
TELEGRAM_WEBHOOK_BASE=
# Random secret — used as the Telegram webhook URL path and secret-token header.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Railway sets PORT automatically; locally you can leave this.
PORT=8080
